PORT=3000
CORS_ORIGINS=*
MAX_FILES_PER_JOB=250
MAX_FILE_SIZE_MB=10
WORKER_CONCURRENCY=3
MAX_QUEUED_JOBS=500
POLL_INTERVAL_MS=1500
SSE_POLL_INTERVAL_MS=1000
QUEUE_RETENTION_HOURS=24

GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cvmatch
REDIS_URL=redis://localhost:6379
RUN_JOB_WORKER=true
